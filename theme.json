{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,

  "settings": {
    "appearanceTools": true,

    "layout": {
      "contentSize": "1200px",
      "wideSize": "1400px"
    },

    "useRootPaddingAwareAlignments": true,

    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "primary",
          "name": "Primary",
          "color": "#2F6F3E"
        },
        {
          "slug": "primary-dark",
          "name": "Primary Dark",
          "color": "#1F4E2C"
        },
        {
          "slug": "secondary",
          "name": "Secondary",
          "color": "#C69214"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#D97706"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#FFFFFF"
        },
        {
          "slug": "surface-alt",
          "name": "Surface Alt",
          "color": "#F6F7F4"
        },
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#172018"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#5D6A61"
        },
        {
          "slug": "white",
          "name": "White",
          "color": "#FFFFFF"
        },
        {
          "slug": "black",
          "name": "Black",
          "color": "#000000"
        }
      ],
      "gradients": [
        {
          "slug": "forest-breeze",
          "name": "Forest Breeze",
          "gradient": "linear-gradient(135deg, #1F4E2C 0%, #2F6F3E 55%, #4E8F5B 100%)"
        },
        {
          "slug": "safari-sun",
          "name": "Safari Sun",
          "gradient": "linear-gradient(135deg, #D97706 0%, #C69214 60%, #B45309 100%)"
        },
        {
          "slug": "savanna-dusk",
          "name": "Savanna Dusk",
          "gradient": "linear-gradient(135deg, #172018 0%, #2F6F3E 45%, #D97706 100%)"
        }
      ]
    },

    "spacing": {
      "units": [
        "px",
        "em",
        "rem",
        "%",
        "vh",
        "vw"
      ],
      "spacingSizes": [
        {
          "slug": "20",
          "name": "2XS",
          "size": "0.5rem"
        },
        {
          "slug": "30",
          "name": "XS",
          "size": "0.75rem"
        },
        {
          "slug": "40",
          "name": "S",
          "size": "1rem"
        },
        {
          "slug": "50",
          "name": "M",
          "size": "1.5rem"
        },
        {
          "slug": "60",
          "name": "L",
          "size": "2.5rem"
        },
        {
          "slug": "70",
          "name": "XL",
          "size": "4rem"
        }
      ]
    },

    "typography": {
      "fluid": true,

      "fontFamilies": [
        {
          "slug": "system",
          "name": "System",
          "fontFamily": "Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif",
          "fontFace": []
        },
        {
          "slug": "display",
          "name": "Display Serif",
          "fontFamily": "'Iowan Old Style', 'Palatino Linotype', 'Book Antiqua', Palatino, Georgia, serif",
          "fontFace": []
        }
      ],

      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem"
        },
        {
          "slug": "medium",
          "name": "Medium",
          "size": "1.125rem"
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "clamp(1.5rem, 3vw, 2rem)"
        },
        {
          "slug": "x-large",
          "name": "Extra Large",
          "size": "clamp(2rem, 4vw, 3rem)"
        },
        {
          "slug": "hero",
          "name": "Hero",
          "size": "clamp(2.5rem, 6vw, 4rem)"
        }
      ]
    },

    "blocks": {
      "core/button": {
        "border": {
          "radius": true
        },
        "color": {
          "text": true,
          "background": true
        }
      },

      "core/navigation": {
        "typography": {
          "fontSize": "1rem"
        }
      },

      "core/heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|display"
        }
      },

      "core/pullquote": {
        "typography": {
          "fontFamily": "var:preset|font-family|display"
        }
      }
    }
  },

  "styles": {
    "color": {
      "background": "#FBFCFA",
      "text": "#172018"
    },

    "typography": {
      "fontFamily": "var:preset|font-family|system",
      "fontSize": "1rem",
      "lineHeight": "1.7"
    },

    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "left": "1rem",
        "right": "1rem"
      }
    },

    "elements": {
      "link": {
        "color": {
          "text": "#1F4E2C"
        },
        ":hover": {
          "color": {
            "text": "#D97706"
          }
        }
      },
      "button": {
        "border": {
          "radius": "999px"
        },
        "color": {
          "background": "#2F6F3E",
          "text": "#FFFFFF"
        },
        "typography": {
          "fontWeight": "600"
        }
      },
      "heading": {
        "typography": {
          "fontWeight": "700",
          "lineHeight": "1.15",
          "letterSpacing": "-0.02em"
        }
      }
    },

    "variations": [
      {
        "name": "forest",
        "title": "Forest (default)",
        "settings": {
          "color": {
            "palette": [
              {
                "slug": "primary",
                "name": "Primary",
                "color": "#2F6F3E"
              },
              {
                "slug": "accent",
                "name": "Accent",
                "color": "#D97706"
              }
            ]
          }
        }
      },
      {
        "name": "desert",
        "title": "Desert",
        "settings": {
          "color": {
            "palette": [
              {
                "slug": "primary",
                "name": "Primary",
                "color": "#B45309"
              },
              {
                "slug": "accent",
                "name": "Accent",
                "color": "#C2410C"
              }
            ]
          }
        }
      },
      {
        "name": "savanna",
        "title": "Savanna",
        "settings": {
          "color": {
            "palette": [
              {
                "slug": "primary",
                "name": "Primary",
                "color": "#5C6B2E"
              },
              {
                "slug": "accent",
                "name": "Accent",
                "color": "#C69214"
              }
            ]
          }
        }
      },
      {
        "name": "ocean",
        "title": "Ocean",
        "settings": {
          "color": {
            "palette": [
              {
                "slug": "primary",
                "name": "Primary",
                "color": "#0F766E"
              },
              {
                "slug": "accent",
                "name": "Accent",
                "color": "#0284C7"
              }
            ]
          }
        }
      }
    ]
  },

  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],

  "customTemplates": [
    {
      "name": "blank",
      "title": "Blank Page",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "template-full-width",
      "title": "Full Width Page",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "template-no-title",
      "title": "No Title Page",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "template-landing",
      "title": "Landing Page",
      "postTypes": [
        "page"
      ]
    }
  ]
}
